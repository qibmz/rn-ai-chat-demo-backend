# App
NODE_ENV=development
PORT=3000
# Display name (emails, Swagger, logs) — do not hardcode in source
APP_NAME=牛马AI
# Used in email verification links (no trailing slash)
APP_URL=http://localhost:3000

# PostgreSQL (docker compose + Prisma)
POSTGRES_USER=nest_starter
POSTGRES_PASSWORD=nest_starter_secret
POSTGRES_DB=nest_starter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nest_starter:nest_starter_secret@localhost:5432/nest_starter?schema=public

# Redis (cache / refresh tokens / BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT — MUST replace before start (placeholder values are rejected by validateEnv)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Trust proxy hops (1 / true / number). Production defaults to 1 when unset in code.
TRUST_PROXY=0

# CORS — production allowlist (comma-separated). Non-prod always reflects any Origin.
CORS_ORIGINS=

# Swagger (prod defaults off unless SWAGGER_ENABLED=true)
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs

# Prisma seed — npm run prisma:seed
SEED_EMAIL=admin@example.com
SEED_PASSWORD=password123

# Sentry Cloud (optional — leave empty to disable)
# https://sentry.io
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Resend email (optional — leave empty to stub jobs in logs)
# https://resend.com
RESEND_API_KEY=
# Unverified: onboarding@resend.dev (often only to your Resend signup email)
# Production: noreply@yourdomain.com after domain verification
# Optional; defaults to `${APP_NAME} <onboarding@resend.dev>` when empty
MAIL_FROM=
# Email verification token TTL (s/m/h/d)
EMAIL_VERIFY_EXPIRES_IN=24h
# Cooldown between resend-verification sends per email (s/m/h/d)
EMAIL_VERIFY_COOLDOWN=60s
# When true, login rejects unverified emails (403)
EMAIL_VERIFICATION_REQUIRED=false
# Password reset code TTL (s/m/h/d)
PASSWORD_RESET_EXPIRES_IN=15m
# Cooldown between forgot-password sends per email (s/m/h/d)
PASSWORD_RESET_COOLDOWN=60s

# Global HTTP rate limit (Nest Throttler; Redis-backed across instances)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
