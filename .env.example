# App
NODE_ENV=development
PORT=3000
# Display name (emails, Swagger, logs) — do not hardcode in source
APP_NAME=牛马AI
# Used in email verification links (no trailing slash)
APP_URL=http://localhost:3000

# PostgreSQL (docker compose + Prisma)
POSTGRES_USER=nest_starter
POSTGRES_PASSWORD=nest_starter_secret
POSTGRES_DB=nest_starter
POSTGRES_PORT=5432
DATABASE_URL=postgresql://nest_starter:nest_starter_secret@localhost:5432/nest_starter?schema=public

# Redis (cache / refresh tokens / BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# JWT — MUST replace before start (placeholder values are rejected by validateEnv)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Trust proxy hops (1 / true / number). Production defaults to 1 when unset in code.
TRUST_PROXY=0

# CORS — production allowlist (comma-separated). Non-prod always reflects any Origin.
CORS_ORIGINS=

# Swagger (prod defaults off unless SWAGGER_ENABLED=true)
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs

# Prisma seed — npm run prisma:seed
SEED_EMAIL=admin@example.com
SEED_PASSWORD=password123

# Sentry Cloud (optional — leave empty to disable)
# https://sentry.io
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Resend email (optional — leave empty to stub jobs in logs)
# https://resend.com
RESEND_API_KEY=
# Unverified: onboarding@resend.dev (often only to your Resend signup email)
# Production: noreply@yourdomain.com after domain verification
# Optional; defaults to `${APP_NAME} <onboarding@resend.dev>` when empty
MAIL_FROM=
# Email verification token TTL (s/m/h/d)
EMAIL_VERIFY_EXPIRES_IN=24h
# Cooldown between resend-verification sends per email (s/m/h/d)
EMAIL_VERIFY_COOLDOWN=60s
# When true, login rejects unverified emails (403)
EMAIL_VERIFICATION_REQUIRED=false
# Password reset code TTL (s/m/h/d)
PASSWORD_RESET_EXPIRES_IN=15m
# Cooldown between forgot-password sends per email (s/m/h/d)
PASSWORD_RESET_COOLDOWN=60s

# Global HTTP rate limit (Nest Throttler; Redis-backed across instances)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# LLM（OpenAI 兼容网关 + 官方 @ai-sdk 包；本迭代仅 deepseek）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash

# 附件存储：r2（默认）| disabled（纯文本开发 / CI）
CHAT_ATTACHMENT_STORAGE=disabled
# R2（CHAT_ATTACHMENT_STORAGE=r2 时必填；请使用独立私有桶）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=niuma-ai-chat-attachments
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_REGION=auto
# 读接口现签 TTL（秒），建议 300–900
R2_PRESIGN_EXPIRES_SEC=600

# 聊天：输出上限 / 思考默认 / 图片
CHAT_MAX_TOKENS=4096
CHAT_THINKING_DEFAULT=true
CHAT_REASONING_EFFORT_DEFAULT=high
CHAT_SYSTEM_PROMPT=
CHAT_MAX_USER_CHARS=8000
CHAT_IMAGE_DETAIL=low
CHAT_MAX_IMAGE_BYTES=8388608
CHAT_MAX_IMAGES_PER_MESSAGE=3
CHAT_MAX_TOTAL_IMAGE_BYTES=16777216
CHAT_CONTEXT_MAX_TURNS=20
CHAT_CONTEXT_MAX_CHARS=32000
CHAT_CONTEXT_IMAGE_TURNS=3
CHAT_MAX_CONCURRENT_STREAMS=2
CHAT_STREAM_LOCK_TTL_SEC=1800

# 周预算（软限制，内部按微元记账；对外只返回百分比）
# 时区用于自然周边界（下周一 0 点重置）
CHAT_QUOTA_TZ=Asia/Shanghai
CHAT_USER_WEEKLY_BUDGET_CNY=10
# 单价：微元 / 百万 token（整数；约等于 ¥/1M × 1e6）
# 换算提示：美元价 × CHAT_CNY_PER_USD(文档用，默认 7.2) × 1e6 → 微元/百万
# 例：$0.15/1M × 7.2 ≈ ¥1.08 → 1080000 微元/百万
CHAT_PRICE_INPUT_MISS_MICROS_PER_MTOKENS=1065000
CHAT_PRICE_INPUT_HIT_MICROS_PER_MTOKENS=21600
CHAT_PRICE_OUTPUT_MICROS_PER_MTOKENS=4320000
CHAT_PRICE_VERSION=2026-10-deepseek-flash
